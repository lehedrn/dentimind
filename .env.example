# ===========================================
# 口腔医院AI客服系统 - 环境变量配置
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写实际的API凭证
# 3. 不要将 .env 文件提交到代码仓库
# ===========================================

# ---------- 阿里云CCC配置 ----------
# CCC实例ID（在CCC控制台获取）
CCC_INSTANCE_ID=your-ccc-instance-id

# 阿里云AccessKey（在RAM控制台获取）
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# CCC分配的号码（用于外呼显示）
CCC_CALLER_NUMBER=01012345678

# CCC区域（根据实例所在区域调整）
CCC_REGION_ID=cn-shanghai

# ---------- 阿里云百炼配置 ----------
# 百炼智能体应用ID（在百炼控制台获取）
BAILIAN_APP_ID=your-bailian-app-id

# 百炼API Key（在百炼控制台API Key管理获取）
DASHSCOPE_API_KEY=your-dashscope-api-key

# ---------- 数据库配置 ----------
# 数据库连接URL
# MySQL格式：mysql+pymysql://user:password@host:port/database
# PostgreSQL格式：postgresql://user:password@host:port/database
# SQLite格式：sqlite:///./dental_ai.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/dental_ai

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ---------- 服务配置 ----------
# FastAPI服务端口
API_PORT=8000

# FastAPI服务Host
API_HOST=0.0.0.0

# 是否开启调试模式（生产环境设为false）
DEBUG=true

# ---------- CORS配置 ----------
# 允许的前端域名（多个用逗号分隔）
# 生产环境应限制为具体域名，如：http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# ---------- 日志配置 ----------
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/app.log

# ---------- Webhook配置 ----------
# CCC通话结果回调地址（需要公网可访问）
# 例如：https://yourdomain.com/api/webhook/ccc/call-ended
CCC_WEBHOOK_URL=http://localhost:8000/api/webhook/ccc/call-ended

# ---------- 其他配置 ----------
# 时区设置
TIMEZONE=Asia/Shanghai

# 文件上传大小限制（MB）
MAX_UPLOAD_SIZE=10

# 会话超时时间（秒）
SESSION_TIMEOUT=1800
